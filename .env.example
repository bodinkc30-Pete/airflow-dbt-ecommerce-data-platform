# Project
PROJECT_NAME=airflow-dbt-ecommerce-data-platform
PROJECT_ENV=development

# Data mode
DATA_MODE=demo

# Paths
DATA_DEMO_DIR=data/demo
DATA_PRIVATE_DIR=data/private
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_ROLE=ecommerce_ingest_writer
POSTGRES_HOST_PORT=5432
POSTGRES_MEM_LIMIT=1g

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_API_HOST_PORT=8080
AIRFLOW_INIT_MEM_LIMIT=1g
AIRFLOW_API_MEM_LIMIT=768m
AIRFLOW_SCHEDULER_MEM_LIMIT=2g
AIRFLOW_DAG_PROCESSOR_MEM_LIMIT=512m
AIRFLOW_TRIGGERER_MEM_LIMIT=768m

# dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_TARGET=dev
DBT_POSTGRES_HOST=postgres
DBT_POSTGRES_PORT=5432
DBT_POSTGRES_DB=ecommerce
DBT_POSTGRES_USER=airflow
DBT_POSTGRES_PASSWORD=change_me
DBT_POSTGRES_ROLE=ecommerce_transformer
DBT_SCHEMA=analytics
DBT_THREADS=2

# Pipeline monitoring / alerting
PIPELINE_SLOW_THRESHOLD_SECONDS=180
# HTTPS only — other schemes are rejected by the alerting code (SSRF guard)
PIPELINE_ALERT_WEBHOOK_URL=
PIPELINE_ALERT_NOTIFY_WARNINGS=false

# Idempotency recovery: files stuck in "processing" longer than this many
# minutes (e.g. worker killed mid-load) are automatically retried instead of
# blocking every subsequent run.
STALE_PROCESSING_TTL_MINUTES=60

# --- Mode-specific settings (uncomment when needed) ---
# S3 mode (DATA_MODE=s3):
# S3_DATA_BUCKET=
# S3_DATA_PREFIX=landing
# DATA_CLOUD_STAGING_DIR=/opt/airflow/data/cloud
# Cloud bootstrap (scripts/bootstrap_cloud_database.py):
# RDS_MASTER_USER=
# RDS_MASTER_PASSWORD=
# FAB admin bootstrap (scripts/bootstrap_fab_admin.py):
# FAB_ADMIN_USERNAME=
# FAB_ADMIN_PASSWORD=
# Diagnostics (scripts/diagnose_pipeline_run.py):
# AIRFLOW_METADATA_DB=airflow

# Docker runtime logging
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
